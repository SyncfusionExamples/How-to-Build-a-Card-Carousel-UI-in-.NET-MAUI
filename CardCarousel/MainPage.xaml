<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:carousel="clr-namespace:Syncfusion.Maui.Carousel;assembly=Syncfusion.Maui.Carousel"
            xmlns:viewModel="clr-namespace:CardCarousel"
             x:Class="CardCarousel.MainPage">
<ContentPage.BindingContext>
    <viewModel:CardViewModel/>
</ContentPage.BindingContext>

<Grid RowDefinitions="Auto,*"
      BackgroundColor="#F5F7FA">

    <!-- Header -->
    <VerticalStackLayout  Grid.Row="0"
                          Padding="20,30,20,10">

        <Label Text="Popular Destinations"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="#0F172A"/>

        <Label Text="Explore amazing places around the world"
               FontSize="14"
               TextColor="#64748B"/>
    </VerticalStackLayout>

        <!-- Carousel -->
    <carousel:SfCarousel Grid.Row="1"
                         ItemsSource="{Binding Places}"
                         ItemWidth="320"
                         ItemHeight="450"
                         ItemSpacing="20"
                         ViewMode="Default"
                         HeightRequest="500">
        <carousel:SfCarousel.ItemTemplate>
            <DataTemplate>
                <Border BackgroundColor="#F0F9FF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 30">
                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Radius="18"
                                Opacity="0.15"
                                Offset="0,8" />
                    </Border.Shadow>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="260" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Image Section -->
                        <Grid Grid.Row="0">
                            <Image Source="{Binding Image}"
                                   Aspect="AspectFill" />
                            <!-- Rating Badge -->
                            <Border HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="15"
                                    Padding="10,5"
                                    BackgroundColor="#CC000000"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="★"
                                           FontSize="14"
                                           TextColor="Gold" />
                                    <Label Text="{Binding Rating}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <!-- Details Section -->
                        <VerticalStackLayout
                            Grid.Row="1"
                            Padding="20"
                            Spacing="8">
                            <Label Text="{Binding Title}"
                                   TextColor="#1E293B"
                                   FontSize="24"
                                   FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="📍"
                                       FontSize="14" />
                                <Label Text="{Binding Country}"
                                       FontSize="14"
                                       TextColor="#64748B" />

                            </HorizontalStackLayout>
                            <Label Text="{Binding Description}"
                                   FontSize="13"
                                   TextColor="#94A3B8"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Grid Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Starting From"
                                           FontSize="12"
                                           TextColor="#94A3B8" />
                                    <Label Text="{Binding StartingPrice}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#10B981" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Explore"
                                        WidthRequest="110"
                                        HeightRequest="44"
                                        CornerRadius="14"
                                        BackgroundColor="#2563EB"
                                        TextColor="White"
                                        VerticalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </carousel:SfCarousel.ItemTemplate>
    </carousel:SfCarousel>
</Grid>
</ContentPage>
    